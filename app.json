{
  "expo": {
    "name": "Meeting Pulse",
    "slug": "meeting-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meetingpulse",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.meetingpulse.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.meetingpulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#070A12",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A12"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#FF7958",
          "defaultChannel": "meeting-pulse-daily",
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ec45ba4-8c4c-4d4f-8970-36859a2ac595"
      }
    },
    "owner": "meetslimshady07"
  }
}
